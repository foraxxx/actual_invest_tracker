<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2: портфель сверху, ближайшая выплата снизу. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView android:id="@+id/title" style="@style/WidgetLabel" />

    <TextView android:id="@+id/value" style="@style/WidgetValue" />

    <TextView android:id="@+id/day" style="@style/WidgetChange" />

    <TextView android:id="@+id/total" style="@style/WidgetDim" android:layout_marginTop="3dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_divider" />

    <TextView android:id="@+id/b1_title" style="@style/WidgetLabel" />

    <TextView android:id="@+id/b1_main" style="@style/WidgetMain" android:layout_marginTop="4dp" />

    <TextView android:id="@+id/b1_sub" style="@style/WidgetDim" android:layout_marginTop="2dp" />

    <ProgressBar
        android:id="@+id/b1_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress" />
</LinearLayout>
