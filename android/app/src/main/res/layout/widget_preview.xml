<?xml version="1.0" encoding="utf-8"?>
<!-- Картинка виджета в списке виджетов. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                style="@style/WidgetLabel"
                android:layout_width="0dp"
                android:layout_weight="1" android:text="Все портфели" />

            <TextView
                android:id="@+id/time"
                style="@style/WidgetDim"
                android:layout_width="wrap_content"
                android:layout_marginStart="6dp" android:text="14:30" />
        </LinearLayout>

        <TextView android:id="@+id/value" style="@style/WidgetValue" android:layout_height="34dp" android:autoSizeMaxTextSize="26dp" android:text="2 135 410 ₽" />

        <TextView android:id="@+id/day" style="@style/WidgetChange" android:text="▲ 3 240 ₽ · 0,15% сегодня" />

        <TextView android:id="@+id/total" style="@style/WidgetDim" android:layout_marginTop="3dp" android:text="за всё время +107 574 ₽" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_preview_chart" />

            <TextView
                android:id="@+id/chart_empty"
                style="@style/WidgetDim"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="2"
                android:text="График появится через пару дней"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/b1_title" style="@style/WidgetLabel" android:text="Зарплата 15 ноября" />

        <TextView android:id="@+id/b1_main" style="@style/WidgetMain" android:layout_marginTop="4dp" android:text="осталось 21 600 ₽" />

        <TextView android:id="@+id/b1_sub" style="@style/WidgetDim" android:layout_marginTop="2dp" android:text="из 32 400 ₽" />

        <ProgressBar
            android:id="@+id/b1_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress"
            android:progress="333" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <TextView android:id="@+id/b2_title" style="@style/WidgetLabel" android:text="Аванс 30 ноября" />

        <TextView android:id="@+id/b2_main" style="@style/WidgetMain" android:layout_marginTop="4dp" android:text="осталось 21 700 ₽" />

        <TextView android:id="@+id/b2_sub" style="@style/WidgetDim" android:layout_marginTop="2dp" android:text="из 21 700 ₽" />

        <ProgressBar
            android:id="@+id/b2_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress"
            android:progress="0" />
    </LinearLayout>
</LinearLayout>
