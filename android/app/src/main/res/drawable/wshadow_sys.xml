<?xml version="1.0" encoding="utf-8"?>
<!-- Имитация тени: тёмные кольца, плотнее к краю карточки. Настоящей тени
     у виджетов Android нет. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#06000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#0A000000" />
            <corners android:radius="29dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#10000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#18000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#22000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#30000000" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
